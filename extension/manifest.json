{
  "manifest_version": 3,
  "name": "知乎回答长图",
  "version": "1.9.2",
  "description": "导出知乎前 X 条或单条回答（含问题），支持 PNG、SVG、HTML、PDF、WebP。作者 jasonLi。",
  "author": "jasonLi",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.zhimg.com/*",
    "https://zhimg.com/*",
    "https://*.zhihu.com/*",
    "https://zhihu.com/*",
    "https://*.vzuu.com/*",
    "https://vzuu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "知乎回答长图"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*"
      ],
      "js": [
        "vendor/html2canvas.min.js",
        "vendor/jspdf.umd.min.js",
        "bridge.js",
        "core.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
